# Only fill the empty values. Restart the server after any change.

# ─── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=MonProjet
# Public address of the site, without trailing slash (https://your-domain.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional, e.g. +237 6XX XX XX XX
NEXT_PUBLIC_CONTACT_PHONE=
# development | staging | production  (production refuses sandbox payments)
APP_ENV=development

# ─── Supabase  (Settings > API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server only. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payments ──────────────────────────────────────────────────────────
# sandbox = test payments, no real money (refused when APP_ENV=production)
# fapshi  = MTN / Orange Mobile Money via Fapshi (XAF only)
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=

# Fapshi — MTN / Orange Mobile Money, XAF only (Fapshi dashboard > Developers > New Service)
# sandbox = test credentials (Sandbox tab) · live = real money (API tab, needs an activated account)
FAPSHI_ENV=sandbox
FAPSHI_API_USER=
FAPSHI_API_KEY=
# Optional but recommended: set the same secret in the Fapshi service webhook settings.
# Webhook URL to enter in Fapshi: <NEXT_PUBLIC_SITE_URL>/api/webhooks/payments/fapshi
FAPSHI_WEBHOOK_SECRET=

# ─── Audio / video calls (Jitsi Meet — free, no key needed) ────────────
# Change only if you self-host Jitsi or use 8x8 JaaS
JITSI_DOMAIN=meet.jit.si
# Signs call-room names so they cannot be guessed
VIDEO_ROOM_SECRET=

# ─── AI assistant (Google Gemini) ──────────────────────────────────────
# Key: https://aistudio.google.com/apikey — SECRET, server only (never NEXT_PUBLIC_)
GEMINI_API_KEY=
# Model id — see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# ─── Email ─────────────────────────────────────────────────────────────
# console (prints e-mails in the server log) | resend
EMAIL_PROVIDER=console
# https://resend.com/api-keys — needed only when EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="MonProjet <no-reply@monprojet.com>"

# ─── Scheduled jobs ────────────────────────────────────────────────────
# Shared secret for /api/cron/maintenance (frees unpaid slots, sends e-mails)
CRON_SECRET=

# ─── Rate limiting (optional — Upstash Redis; without it limits are kept in memory) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
